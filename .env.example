NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
API_HOST=0.0.0.0
# Listen port: API_PORT, then the platform-injected PORT, then 3000.
API_PORT=3000
DEMO_HOST=0.0.0.0
# Listen port: DEMO_PORT, then the platform-injected PORT, then 3100.
DEMO_PORT=3100
DEMO_FAILURE_INJECTION_ENABLED=false
MONITOR_ENABLED=true
MONITOR_SERVICE_NAME=demo-service
MONITOR_HEALTH_URL=http://localhost:3100/health
MONITOR_INTERVAL_MS=5000
MONITOR_TIMEOUT_MS=2000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=3
KORA_ENVIRONMENT=development
# Optional: commit reported by GET /__kora when the image has no build-info.
# KORA_COMMIT_SHA=<40 hex characters>
# Optional provider binding. Set all four required fields together.
# RUMPTY_WORKSPACE=kora
# RUMPTY_REGION=<verified-zone-or-region>
# RUMPTY_RESOURCE_TYPE=virtual_machine
# RUMPTY_RESOURCE_ID=<unique-id-from-rumpty-console>
# RUMPTY_RESOURCE_NAME=kora-demo
# RUMPTY_API_KEY is intentionally not required by the current credentialless adapter.
# Tests: PostgreSQL-backed tests delete rows. They refuse to run unless the
# database name (parsed from DATABASE_URL) ends in "_test", for example:
# DATABASE_URL=postgresql://kora:kora@localhost:5432/kora_test
# Deployment Verification (not cryptographic), optional. See docs/adr/ADR-010.
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main
# GITHUB_TOKEN=            # optional secret; never commit a value
# MONITOR_CLAIM_URL=       # default: the health URL's origin + /__kora
# GITHUB_API_URL=https://api.github.com
# VERIFICATION_INTERVAL_MS=300000
