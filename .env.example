NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora
API_HOST=0.0.0.0
# Listen port: API_PORT, then the platform-injected PORT, then 3000.
API_PORT=3000
DEMO_HOST=0.0.0.0
# Listen port: DEMO_PORT, then the platform-injected PORT, then 3100.
DEMO_PORT=3100
DEMO_FAILURE_INJECTION_ENABLED=false
MONITOR_ENABLED=true
MONITOR_SERVICE_NAME=demo-service
MONITOR_HEALTH_URL=http://localhost:3100/health
MONITOR_INTERVAL_MS=5000
MONITOR_TIMEOUT_MS=2000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=3
KORA_ENVIRONMENT=development
# Optional: commit reported by GET /__kora when the image has no build-info.
# KORA_COMMIT_SHA=<40 hex characters>
# Optional provider binding. Set all four required fields together.
# RUMPTY_WORKSPACE=kora
# RUMPTY_REGION=<verified-zone-or-region>
# RUMPTY_RESOURCE_TYPE=virtual_machine
# RUMPTY_RESOURCE_ID=<unique-id-from-rumpty-console>
# RUMPTY_RESOURCE_NAME=kora-demo
# RUMPTY_API_KEY is intentionally not required by the current credentialless adapter.
# Tests: PostgreSQL-backed tests delete rows. They refuse to run unless the
# database name (parsed from DATABASE_URL) ends in "_test", for example:
# DATABASE_URL=postgresql://kora:kora@localhost:5432/kora_test
# Deployment Verification (not cryptographic), optional. See docs/adr/ADR-010.
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main
# GITHUB_TOKEN=            # optional secret; never commit a value
# MONITOR_CLAIM_URL=       # default: the health URL's origin + /__kora
# GITHUB_API_URL=https://api.github.com
# VERIFICATION_INTERVAL_MS=300000

# ---- Kora platform (customer product) ---------------------------------------
# Public base URL of this deployment: hosted sites, form endpoints, checkout callbacks.
# KORA_PUBLIC_URL=https://kora.example.com
# KORA_MONITOR_BASE_URL=            # where monitors fetch Kora-hosted sites (default: KORA_PUBLIC_URL)
# KORA_COOKIE_SECURE=               # default true in production
# KORA_TRUST_PROXY=                 # default true in production (behind the platform proxy)
# KORA_SIGNUP_ENABLED=true
# KORA_LEGACY_PUBLIC_API=           # default false in production: /incidents, /services, /ui need a session
# KORA_CHAOS_ENABLED=false          # controlled-test fault injection; never enable on real customer sites
# ACTION_VERIFICATION_TIMEOUT_MS=180000
# ACTION_VERIFICATION_TICK_MS=3000
# Inference (any OpenAI-compatible endpoint, e.g. RumptyCloud hosted inference). All three or none.
# INFERENCE_BASE_URL=https://.../v1
# INFERENCE_API_KEY=                # secret
# INFERENCE_MODEL=
# Independent Site Host (production customer-site runtime). Set on the control plane:
# SITE_HOST_PUBLIC_URL=https://kora-site-host.example
# SITE_HOST_RESOURCE_ID=<unique deployment ID from the Rumpty console>
# Set on the Site Host process (node apps/site-host/dist/server.js): DATABASE_URL, SITE_HOST_PUBLIC_URL, optional SITE_HOST_FAULT_DELAY_MS
# Experimental (needs the rumpty CLI, which the image does not contain): KORA_EXPERIMENTAL_RUMPTY_BUCKET=true
# Publishing to Rumpty object storage (documented `rumpty sync`). All four, plus RUMPTY_WORKSPACE.
# RUMPTY_API_KEY=                   # secret
# RUMPTY_SITE_BUCKET=
# RUMPTY_SITE_PUBLIC_BASE_URL=      # public URL of the bucket (not documented by Rumpty; operator-provided)
# RUMPTY_SITE_REGION=
# Billing / domains (optional; features report "not configured" without them)
# PAYSTACK_SECRET_KEY=              # use a test key unless live billing is intended
# KORA_PLANS_JSON=[{"code":"pro","name":"Pro","currency":"NGN","amountMinor":0,"interval":"monthly","capabilities":{...}}]
# ENTRI_APPLICATION_ID=
# OPENPROVIDER_USERNAME=
# OPENPROVIDER_PASSWORD=
