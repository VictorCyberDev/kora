{
  "name": "@kora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@kora/action-executor": "workspace:*",
    "@kora/event-schema": "workspace:*",
    "@kora/incident-engine": "workspace:*",
    "@kora/policy-engine": "workspace:*",
    "@kora/reasoner": "workspace:*",
    "@kora/runtime-claim": "workspace:*",
    "@kora/site-fonts": "workspace:*",
    "@kora/site-media": "workspace:*",
    "@kora/site-schema": "workspace:*",
    "@kora/site-serving": "workspace:*",
    "@kora/topology": "workspace:*",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@kora/site-host": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
