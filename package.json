{
  "name": "kora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kora/api --filter @kora/demo-service dev",
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @kora/api db:migrate",
    "kora:verify": "pnpm --silent --filter @kora/passport run build && node packages/passport/dist/cli.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
